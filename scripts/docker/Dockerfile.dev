# ============================================================
# Dockerfile.dev - Development environment for Ability Draft Plus
#
# Provides a consistent development environment with all dependencies
# pre-installed. Useful for CI/CD or when local setup is problematic.
#
# Usage:
#   docker build -f scripts/docker/Dockerfile.dev -t adplus-dev .
#   docker run --rm -it -v $(pwd):/app adplus-dev bash
#   docker run --rm -it -v $(pwd):/app adplus-dev npm test
# ============================================================

FROM node:18-bookworm

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 \
    python3-pip \
    python3-venv \
    make \
    g++ \
    libx11-dev \
    libxkbfile-dev \
    libsecret-1-dev \
    libglib2.0-dev \
    libnss3 \
    libatk1.0-0 \
    libatk-bridge2.0-0 \
    libcups2 \
    libdrm2 \
    libgtk-3-0 \
    libgbm1 \
    libasound2 \
    libxrandr2 \
    libxcomposite1 \
    libxdamage1 \
    libxfixes3 \
    libpango-1.0-0 \
    libcairo2 \
    git \
    && rm -rf /var/lib/apt/lists/*

# Set up Python virtual environment for mapping scripts
RUN python3 -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

WORKDIR /app

# Default: open a shell
CMD ["bash"]
